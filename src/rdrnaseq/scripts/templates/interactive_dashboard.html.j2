<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FRASER/OUTRIDER Results Dashboard</title>
    <script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/igv@2.15.8/dist/igv.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 20px; background: #f5f5f5; }
        .container { max-width: 1600px; margin: 0 auto; background: white; padding: 20px; border-radius: 10px; box-shadow: 0 2px 10px rgba(0,0,0,.1); }
        h1 { text-align: center; color: #333; }
        h2 { color: #444; border-bottom: 2px solid #eee; padding-bottom: 8px; }
        .controls { background: #f9f9f9; padding: 20px; border-radius: 5px; margin-bottom: 20px; }
        .control-group { display: inline-block; margin-right: 30px; margin-bottom: 10px; }
        .control-group label { display: block; margin-bottom: 5px; font-weight: bold; color: #555; }
        .control-group input, .control-group select { width: 160px; padding: 5px; border: 1px solid #ddd; border-radius: 3px; }
        .plot-container { margin-bottom: 30px; background: #fafafa; padding: 15px; border-radius: 5px; }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 15px; margin-bottom: 25px; }
        .stat-card { background: #f0f4ff; border-radius: 8px; padding: 15px; text-align: center; }
        .stat-card .value { font-size: 2em; font-weight: bold; color: #3b5bdb; }
        .stat-card .label { color: #666; font-size: 0.9em; }
        #loading { text-align: center; padding: 40px; font-size: 1.1em; color: #444; }
        #main-content { display: none; }
        .spinner { border: 5px solid #eee; border-top: 5px solid #3b5bdb; border-radius: 50%; width: 50px; height: 50px; animation: spin 1s linear infinite; margin: 0 auto 20px; }
        @keyframes spin { to { transform: rotate(360deg); } }
        #igv-div { height: 400px; border: 1px solid #ddd; border-radius: 5px; }
        #load-log { text-align: left; display: inline-block; margin-top: 16px; font-family: monospace; font-size: 0.85em; background: #f5f5f5; border-radius: 5px; padding: 12px 20px; min-width: 400px; }
        #load-log div { margin: 3px 0; }
        .log-ok   { color: #2f9e44; }
        .log-wait { color: #e67700; }
        .log-err  { color: #c92a2a; font-weight: bold; }
        #error-detail { background: #fff0f0; border: 1px solid #fcc; border-radius: 5px; padding: 16px; margin: 20px 0; font-family: monospace; white-space: pre-wrap; font-size: 0.9em; color: #c00; display: none; }
        /* Details panel */
        #details-panel { display: none; margin-bottom: 30px; padding: 15px; background: #fff3e0; border-radius: 5px; border-left: 4px solid #ff9800; }
        #details-panel h2 { margin-top: 0; color: #e65100; border-bottom: none; }
        .details-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .details-section { background: white; padding: 10px; border-radius: 5px; border: 1px solid #ddd; }
        .details-section h4 { margin-top: 0; color: #333; border-bottom: 1px solid #eee; padding-bottom: 5px; }
        .detail-row { display: flex; justify-content: space-between; padding: 3px 0; border-bottom: 1px solid #f5f5f5; }
        /* DataTables overrides */
        table.dataTable thead th { background-color: #3b5bdb; color: white; }
        .dt-button { background-color: #3b5bdb !important; color: white !important; border: none !important; padding: 6px 12px; border-radius: 3px; margin-right: 5px; }
    </style>
</head>
<body>
<div class="container">
    <h1>FRASER / OUTRIDER Results Dashboard</h1>

    <div id="error-detail" style="display:none;position:fixed;top:0;left:0;right:0;z-index:9999;background:#fff0f0;border-bottom:3px solid #c00;padding:16px 24px;font-family:monospace;white-space:pre-wrap;font-size:0.85em;color:#c00;max-height:50vh;overflow:auto;"></div>

    <div id="loading">
        <div class="spinner"></div>
        <div>Loading data files&hellip;</div>
        <div id="load-log"></div>
    </div>

    <div id="main-content">
        <div class="stats-grid" id="stats-grid"></div>

        <div class="controls">
            <div class="control-group">
                <label>P-value threshold</label>
                <input type="number" id="pval-thresh" value="{{ default_pvalue_threshold }}" step="0.01" min="0" max="1">
            </div>
            <div class="control-group">
                <label>|&Delta;PSI| threshold</label>
                <input type="number" id="dpsi-thresh" value="{{ default_deltapsi_threshold }}" step="0.05" min="0" max="1">
            </div>
            {% if outrider_csv_filename %}
            <div class="control-group">
                <label>|Z-Score| threshold</label>
                <input type="number" id="zscore-thresh" value="{{ default_zscore_threshold }}" step="0.5" min="0">
            </div>
            {% endif %}
            <div class="control-group">
                <label>Filter by Family ID</label>
                <select id="family-filter" multiple></select>
            </div>
            <div class="control-group" style="margin-top:22px">
                <button onclick="applyThresholds()" style="padding:6px 18px;border:none;background:#3b5bdb;color:white;border-radius:4px;cursor:pointer">Apply</button>
                <button onclick="resetFilters()" style="padding:6px 18px;border:1px solid #aaa;border-radius:4px;cursor:pointer;margin-left:8px">Reset</button>
            </div>
        </div>

        <div class="plot-container">
            <h2>FRASER Volcano Plot (&Delta;PSI vs &minus;log10 p-value)</h2>
            <div id="fraser-volcano"></div>
        </div>

        {% if outrider_csv_filename %}
        <div class="plot-container">
            <h2>OUTRIDER Volcano Plot (log2 FC vs &minus;log10 p-value)</h2>
            <div id="outrider-volcano"></div>
        </div>

        <div class="plot-container" id="common-section" style="display:none">
            <h2>Common Significant Results (both FRASER &amp; OUTRIDER)</h2>
            <table id="common-table" class="display" style="width:100%"></table>
        </div>
        {% endif %}

        <div id="details-panel">
            <h2>Selected Region Details</h2>
            <div class="details-grid">
                <div class="details-section">
                    <h4>FRASER Results</h4>
                    <div id="fraser-details"><em style="color:#999">Click a point in a plot to see details...</em></div>
                </div>
                <div class="details-section">
                    <h4>OUTRIDER Results</h4>
                    <div id="outrider-details"><em style="color:#999">Click a point in a plot to see details...</em></div>
                </div>
            </div>
        </div>

        <div class="plot-container">
            <h2>IGV Browser (FRASER hits)</h2>
            <div id="igv-div"></div>
        </div>

        {% if variant_tsv_filename %}
        <div class="plot-container">
            <h2>Rare Variants of Interest</h2>
            <div style="margin-bottom:12px">
                <label style="font-weight:bold;color:#555">Max FRASER distance (bp): </label>
                <input type="number" id="fraser-dist-thresh" value="200" step="50" min="0" style="width:100px;padding:5px;border:1px solid #ddd;border-radius:3px">
                <button onclick="applyVariantFilter()" style="padding:6px 18px;border:none;background:#3b5bdb;color:white;border-radius:4px;cursor:pointer;margin-left:8px">Filter</button>
                <button onclick="resetVariantFilter()" style="padding:6px 18px;border:1px solid #aaa;border-radius:4px;cursor:pointer;margin-left:4px">Show All</button>
            </div>
            <table id="variant-table" class="display" style="width:100%"></table>
        </div>
        {% endif %}

        <div class="plot-container">
            <h2>FRASER Results Table</h2>
            <table id="fraser-table" class="display" style="width:100%"></table>
        </div>

        {% if outrider_csv_filename %}
        <div class="plot-container">
            <h2>OUTRIDER Results Table</h2>
            <table id="outrider-table" class="display" style="width:100%"></table>
        </div>
        {% endif %}
    </div>
</div>

<script>
// ─── Config (from Jinja2 — small data only) ─────────────────────────────────
const FILES = {
    fraser:  {{ fraser_csv_filename | tojson }},
    outrider: {{ outrider_csv_filename | tojson }},
    variant_bed: {{ variant_bed_filename | tojson }},
    variant_tsv: {{ variant_tsv_filename | tojson }},
};
const FAMILY_MAP   = {{ family_map | tojson }};
const ENSG_TO_HGNC = {{ ensg_to_hgnc | tojson }};
const GENOME       = {{ genome | tojson }};
const DEFAULT_PVAL   = {{ default_pvalue_threshold }};
const DEFAULT_DPSI   = {{ default_deltapsi_threshold }};
const DEFAULT_ZSCORE = {{ default_zscore_threshold }};

// ─── Globals ─────────────────────────────────────────────────────────────────
let fraserRows = [], outriderRows = [], variantRows = [];
let igvBrowser = null;
let fraserDT = null, outriderDT = null, commonDT = null, variantDT = null;

// ─── Load log UI ─────────────────────────────────────────────────────────────
function logLine(id, msg, cls) {
    let el = document.getElementById('ll-' + id);
    if (!el) {
        el = document.createElement('div');
        el.id = 'll-' + id;
        document.getElementById('load-log').appendChild(el);
    }
    el.className = cls || '';
    el.textContent = msg;
}

// ─── Fetch + parse one CSV via relative URL ──────────────────────────────────
async function fetchCSV(label, filename) {
    const url = filename.startsWith('./') ? filename : './' + filename;
    logLine(label, 'Fetching ' + url + '...', 'log-wait');

    let resp;
    try { resp = await fetch(url); }
    catch (netErr) {
        logLine(label, 'Network error for ' + url + ': ' + netErr, 'log-err');
        throw new Error('Network error fetching ' + url + ': ' + netErr);
    }

    logLine(label, '  HTTP ' + resp.status + ' ' + resp.statusText +
        (resp.redirected ? ' (redirected to ' + resp.url + ')' : ''),
        resp.ok ? 'log-wait' : 'log-err');

    if (!resp.ok) throw new Error('HTTP ' + resp.status + ' ' + resp.statusText + ' — ' + url);

    const ct = resp.headers.get('content-type') || '';
    if (ct.includes('text/html'))
        throw new Error('Got HTML instead of CSV for ' + url + ' — file may not exist or auth redirect.');

    logLine(label, 'Parsing ' + url + '...', 'log-wait');
    const text = await resp.text();

    const delimiter = filename.endsWith('.tsv') ? '\t' : ',';
    return new Promise((resolve, reject) => {
        Papa.parse(text, {
            header: true, dynamicTyping: true, skipEmptyLines: true, delimiter: delimiter,
            complete: r => { logLine(label, url + ' — ' + r.data.length + ' rows', 'log-ok'); resolve(r.data); },
            error:   e => { logLine(label, 'Parse error: ' + e, 'log-err'); reject(new Error('CSV parse: ' + e)); },
        });
    });
}

// ─── Utilities ───────────────────────────────────────────────────────────────
function log10p(p) { return -Math.log10(Math.max(p, 5e-324)); }

// ─── Stats ───────────────────────────────────────────────────────────────────
function renderStats(commonCount) {
    const pval   = parseFloat(document.getElementById('pval-thresh').value);
    const dpsi   = parseFloat(document.getElementById('dpsi-thresh').value);
    const zEl    = document.getElementById('zscore-thresh');
    const zscore = zEl ? parseFloat(zEl.value) : DEFAULT_ZSCORE;

    const fSig = fraserRows.filter(r => r.padjust <= pval && Math.abs(r.deltaPsi) >= dpsi).length;
    const families = new Set(fraserRows.map(r => r.familyID).filter(f => f && f !== 'Unknown'));

    const cards = [
        { value: fraserRows.length, label: 'Total FRASER Results' },
        { value: fSig,              label: 'Significant FRASER' },
        { value: families.size,     label: 'Families' },
    ];
    if (outriderRows.length) {
        const oSig = outriderRows.filter(r => r.padjust <= pval && Math.abs(r.zScore || 0) >= zscore).length;
        cards.push({ value: outriderRows.length, label: 'Total OUTRIDER Results' });
        cards.push({ value: oSig, label: 'Significant OUTRIDER' });
        if (commonCount !== null) cards.push({ value: commonCount, label: 'Common Significant' });
    }

    document.getElementById('stats-grid').innerHTML = cards.map(c =>
        '<div class="stat-card"><div class="value">' + c.value + '</div><div class="label">' + c.label + '</div></div>'
    ).join('');
}

// ─── Family filter ───────────────────────────────────────────────────────────
function populateFamilyFilter() {
    const families = new Set();
    fraserRows.forEach(r => { if (r.familyID && r.familyID !== 'Unknown') families.add(r.familyID); });
    outriderRows.forEach(r => { if (r.familyID && r.familyID !== 'Unknown') families.add(r.familyID); });
    const sel = document.getElementById('family-filter');
    [...families].sort().forEach(f => {
        const opt = document.createElement('option');
        opt.value = f; opt.textContent = f; sel.appendChild(opt);
    });
    $('#family-filter').select2({ placeholder: 'Search families...', allowClear: true, width: '350px' });
}

// ─── FRASER Volcano ──────────────────────────────────────────────────────────
function renderFraserVolcano(rows, pval, dpsi) {
    const passP = r => r.padjust <= pval;
    const passE = r => Math.abs(r.deltaPsi) >= dpsi;
    const both    = rows.filter(r => passP(r) && passE(r));
    const pOnly   = rows.filter(r => passP(r) && !passE(r));
    const eOnly   = rows.filter(r => !passP(r) && passE(r));
    const neither = rows.filter(r => !passP(r) && !passE(r));
    const mkTrace = (pts, color, name) => ({
        x: pts.map(r => r.deltaPsi),
        y: pts.map(r => log10p(r.pValue)),
        mode: 'markers', type: 'scatter', name,
        marker: { color, size: 5, opacity: 0.7 },
        text: pts.map(r =>
            'Gene: ' + (r.hgncSymbol || 'NA') +
            '<br>SG ID: ' + r.sampleID +
            '<br>Participant: ' + (r.participantExternalId || 'NA') +
            '<br>Family: ' + (r.familyID || 'NA') +
            '<br>Affected: ' + (r.affected != null ? r.affected : 'NA') +
            '<br>\u0394\u03A8: ' + (r.deltaPsi || 0).toFixed(3) +
            '<br>padj: ' + (r.padjust || 0).toExponential(2)),
        hovertemplate: '%{text}<extra></extra>',
        customdata: pts.map(r => [r.seqnames, r.start, r.end]),
    });
    Plotly.react('fraser-volcano',
        [
            mkTrace(neither, '#aaa',     'Not significant'),
            mkTrace(pOnly,   '#f76707',  'Sig. p-value only'),
            mkTrace(eOnly,   '#3b5bdb',  'Large \u0394\u03A8 only'),
            mkTrace(both,    '#e03131',  'Fully significant'),
        ],
        {
            xaxis: { title: '\u0394\u03A8', zeroline: true },
            yaxis: { title: '\u2212log10(p-value)' },
            shapes: [
                { type:'line', x0:-dpsi, x1:-dpsi, y0:0, y1:1, yref:'paper', line:{color:'#888',dash:'dot'} },
                { type:'line', x0: dpsi, x1: dpsi, y0:0, y1:1, yref:'paper', line:{color:'#888',dash:'dot'} },
                { type:'line', x0:-1,    x1:1,     y0:log10p(pval), y1:log10p(pval), line:{color:'#888',dash:'dot'} },
            ],
            margin: { t: 20 }, height: 500,
        }
    );
}

// ─── OUTRIDER Volcano ────────────────────────────────────────────────────────
function renderOutriderVolcano(rows, pval, zscore) {
    const passP = r => r.padjust <= pval;
    const passE = r => Math.abs(r.zScore || 0) >= zscore;
    const both    = rows.filter(r => passP(r) && passE(r));
    const pOnly   = rows.filter(r => passP(r) && !passE(r));
    const eOnly   = rows.filter(r => !passP(r) && passE(r));
    const neither = rows.filter(r => !passP(r) && !passE(r));
    const fcVal = r => r.l2fc !== undefined && r.l2fc !== null ? r.l2fc : (r.log2fc !== undefined && r.log2fc !== null ? r.log2fc : 0);
    const mkTrace = (pts, color, name) => ({
        x: pts.map(fcVal),
        y: pts.map(r => log10p(r.pValue)),
        mode: 'markers', type: 'scatter', name,
        marker: { color, size: 5, opacity: 0.7 },
        text: pts.map(r =>
            'Gene: ' + (r.hgncSymbol || r.geneID || 'NA') +
            '<br>SG ID: ' + r.sampleID +
            '<br>Participant: ' + (r.participantExternalId || 'NA') +
            '<br>Family: ' + (r.familyID || 'NA') +
            '<br>Affected: ' + (r.affected != null ? r.affected : 'NA') +
            '<br>Z: ' + (r.zScore || 0).toFixed(2) +
            '<br>l2fc: ' + fcVal(r).toFixed(3) +
            '<br>padj: ' + (r.padjust || 0).toExponential(2)),
        hovertemplate: '%{text}<extra></extra>',
    });
    Plotly.react('outrider-volcano',
        [
            mkTrace(neither, '#aaa',     'Not significant'),
            mkTrace(pOnly,   '#f76707',  'Sig. p-value only'),
            mkTrace(eOnly,   '#3b5bdb',  'Large |Z| only'),
            mkTrace(both,    '#e03131',  'Fully significant'),
        ],
        {
            xaxis: { title: 'log2 Fold Change', zeroline: true },
            yaxis: { title: '\u2212log10(p-value)' },
            shapes: [
                { type:'line', x0:-20, x1:20, y0:log10p(pval), y1:log10p(pval), line:{color:'#888',dash:'dot'} },
            ],
            margin: { t: 20 }, height: 500,
        }
    );
}

// ─── Common significant ─────────────────────────────────────────────────────
function findCommon(fRows, oRows, pval, dpsi, zscore) {
    if (!oRows.length) return [];
    const fSig = fRows.filter(r => r.padjust <= pval && Math.abs(r.deltaPsi) >= dpsi);
    const oSig = oRows.filter(r => r.padjust <= pval && Math.abs(r.zScore || 0) >= zscore);

    // Build OUTRIDER lookup by sampleID + hgncSymbol
    const oLookup = {};
    oSig.forEach(r => {
        if (!r.hgncSymbol) return;
        const key = r.sampleID + '|' + r.hgncSymbol;
        if (!oLookup[key] || r.pValue < oLookup[key].pValue) oLookup[key] = r;
    });

    const seen = new Set(), common = [];
    fSig.forEach(fr => {
        if (!fr.hgncSymbol) return;
        const key = fr.sampleID + '|' + fr.hgncSymbol;
        if (seen.has(key)) return;
        const or_ = oLookup[key];
        if (!or_) return;
        seen.add(key);
        common.push({
            gene: fr.hgncSymbol, geneID: or_.geneID, sampleID: fr.sampleID,
            familyID: fr.familyID || 'NA', chr: fr.seqnames, start: fr.start, end: fr.end,
            fraser_padjust: fr.padjust, fraser_deltaPsi: fr.deltaPsi,
            outrider_padjust: or_.padjust, outrider_zScore: or_.zScore,
        });
    });
    return common;
}

// ─── DataTables ──────────────────────────────────────────────────────────────
const SCI = ['pValue', 'padjust', 'fraser_padjust', 'outrider_padjust'];
const DP3 = ['deltaPsi', 'psiValue', 'l2fc', 'log2fc', 'fraser_deltaPsi'];
const DP2 = ['zScore', 'outrider_zScore'];

const COL_TITLES = {sampleID: 'Rna SG ID', rna_sg_ids: 'Rna SG IDs', matching_genome_sg_ids: 'Genome SG IDs'};
const WRAP_COLS = new Set(['rna_sg_ids', 'matching_genome_sg_ids']);

function colTitle(c) {
    if (COL_TITLES[c]) return COL_TITLES[c];
    return c.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
}

function isNA(v) { return v === null || v === undefined || v === '' || v === 'NA'; }

function fmt(k, v) {
    if (isNA(v)) return 'NA';
    if (SCI.includes(k) && typeof v === 'number') return v.toExponential(2);
    if (DP3.includes(k) && typeof v === 'number') return v.toFixed(3);
    if (DP2.includes(k) && typeof v === 'number') return v.toFixed(2);
    if (WRAP_COLS.has(k) && typeof v === 'string') {
        const items = v.replace(/^\[|\]$/g, '').replace(/"/g, '').split(',').map(s => s.trim()).filter(Boolean);
        return items.join('<br>');
    }
    return v;
}

function buildDT(tableId, rows, cols, existing) {
    if (existing) { existing.destroy(); $('#' + tableId).empty(); }
    if (!rows.length) return null;
    const avail = cols.filter(c => rows[0][c] !== undefined);
    return $('#' + tableId).DataTable({
        data: rows.map(r => { const o = {}; avail.forEach(c => o[c] = r[c] !== undefined ? r[c] : 'NA'); return o; }),
        columns: avail.map(c => ({ title: colTitle(c), data: c, type: 'na-bottom', render: d => fmt(c, d) })),
        dom: 'Bfrtip', buttons: ['csv', 'excel'], pageLength: 25, scrollX: true,
    });
}

// Sort NA values to the bottom regardless of sort direction.
// No -pre function: DataTables 1.x falls back to default < / > on preprocessed
// values when -pre is defined, and JS coerces null to 0 in numeric comparisons,
// making NAs and real 0s indistinguishable. Omitting -pre forces DT to use the
// -asc / -desc comparators which handle null explicitly.
function parseSortVal(d) {
    if (d === null || d === undefined) return null;
    if (typeof d === 'number') return isNaN(d) ? null : d;
    const s = String(d).replace(/<[^>]*>/g, '').trim();
    if (s === 'NA' || s === '' || s === 'null' || s === 'undefined' || s === 'NaN') return null;
    const n = parseFloat(s);
    return isNaN(n) ? s : n;
}
$.fn.dataTable.ext.type.order['na-bottom-asc'] = function(a, b) {
    const x = parseSortVal(a), y = parseSortVal(b);
    if (x === null && y === null) return 0;
    if (x === null) return 1;
    if (y === null) return -1;
    return (x < y) ? -1 : (x > y) ? 1 : 0;
};
$.fn.dataTable.ext.type.order['na-bottom-desc'] = function(a, b) {
    const x = parseSortVal(a), y = parseSortVal(b);
    if (x === null && y === null) return 0;
    if (x === null) return 1;
    if (y === null) return -1;
    return (x > y) ? -1 : (x < y) ? 1 : 0;
};

const FRASER_COLS  = ['hgncSymbol', 'geneID', 'seqnames', 'start', 'end', 'type', 'pValue', 'padjust', 'psiValue', 'deltaPsi', 'sampleID', 'familyID'];
const OUTRIDER_COLS = ['geneID', 'hgncSymbol', 'sampleID', 'pValue', 'padjust', 'zScore', 'l2fc', 'log2fc', 'familyID'];
const COMMON_COLS  = ['gene', 'geneID', 'sampleID', 'familyID', 'chr', 'start', 'end', 'fraser_padjust', 'fraser_deltaPsi', 'outrider_padjust', 'outrider_zScore'];
const VARIANT_COLS = ['gene_symbol', 'major_consequence', 'family_id', 'participant_external_id', 'affected', 'fraser_distance', 'splice_ai_delta_score', 'splice_ai_consequence', 'bed_chrom', 'bed_start', 'bed_end', 'rna_sg_ids', 'matching_genome_sg_ids'];

// ─── Selected Region Details ─────────────────────────────────────────────────
function showRegionDetails(chr, start, end) {
    document.getElementById('details-panel').style.display = 'block';
    const padding = 1000;
    const qStart = Math.max(0, start - padding);
    const qEnd   = end + padding;
    const chrNorm = String(chr).startsWith('chr') ? String(chr) : 'chr' + chr;

    // Query FRASER
    const fHits = fraserRows.filter(r => {
        const rc = String(r.seqnames).startsWith('chr') ? String(r.seqnames) : 'chr' + r.seqnames;
        return rc === chrNorm && r.start <= qEnd && r.end >= qStart;
    });
    const fEl = document.getElementById('fraser-details');
    if (fHits.length) {
        let html = '';
        fHits.slice(0, 5).forEach((r, i) => {
            if (i > 0) html += '<hr style="border:none;border-top:1px solid #eee;margin:8px 0">';
            html += '<div>';
            html += '<div class="detail-row"><b>Gene:</b> <span>' + (r.hgncSymbol || 'NA') + '</span></div>';
            html += '<div class="detail-row"><b>Position:</b> <span>' + r.seqnames + ':' + r.start + '-' + r.end + '</span></div>';
            html += '<div class="detail-row"><b>P-adjust:</b> <span>' + (r.padjust != null ? r.padjust.toExponential(2) : 'NA') + '</span></div>';
            html += '<div class="detail-row"><b>Delta PSI:</b> <span>' + (r.deltaPsi != null ? r.deltaPsi.toFixed(4) : 'NA') + '</span></div>';
            html += '<div class="detail-row"><b>PSI Value:</b> <span>' + (r.psiValue != null ? r.psiValue.toFixed(4) : 'NA') + '</span></div>';
            html += '<div class="detail-row"><b>Type:</b> <span>' + (r.type || 'NA') + '</span></div>';
            html += '</div>';
        });
        if (fHits.length > 5) html += '<div style="color:#999;font-style:italic;margin-top:8px">...and ' + (fHits.length - 5) + ' more</div>';
        fEl.innerHTML = html;
    } else {
        fEl.innerHTML = '<em style="color:#999">No FRASER results in this region</em>';
    }

    // Query OUTRIDER (only rows with coordinates)
    const oHits = outriderRows.filter(r => {
        if (!r.seqnames || r.start == null || r.end == null) return false;
        const rc = String(r.seqnames).startsWith('chr') ? String(r.seqnames) : 'chr' + r.seqnames;
        return rc === chrNorm && r.start <= qEnd && r.end >= qStart;
    });
    const oEl = document.getElementById('outrider-details');
    if (oHits.length) {
        let html = '';
        oHits.slice(0, 5).forEach((r, i) => {
            if (i > 0) html += '<hr style="border:none;border-top:1px solid #eee;margin:8px 0">';
            html += '<div>';
            html += '<div class="detail-row"><b>Gene:</b> <span>' + (r.hgncSymbol || r.geneID || 'NA') + '</span></div>';
            html += '<div class="detail-row"><b>Position:</b> <span>' + r.seqnames + ':' + r.start + '-' + r.end + '</span></div>';
            html += '<div class="detail-row"><b>P-adjust:</b> <span>' + (r.padjust != null ? r.padjust.toExponential(2) : 'NA') + '</span></div>';
            html += '<div class="detail-row"><b>Z-score:</b> <span>' + (r.zScore != null ? r.zScore.toFixed(2) : 'NA') + '</span></div>';
            html += '</div>';
        });
        if (oHits.length > 5) html += '<div style="color:#999;font-style:italic;margin-top:8px">...and ' + (oHits.length - 5) + ' more</div>';
        oEl.innerHTML = html;
    } else {
        oEl.innerHTML = '<em style="color:#999">No OUTRIDER results in this region</em>';
    }
}

// ─── Variant table filter ───────────────────────────────────────────────────
function applyVariantFilter() {
    const maxDist = parseFloat(document.getElementById('fraser-dist-thresh').value);
    const filtered = variantRows.filter(r => r.fraser_distance !== null && r.fraser_distance <= maxDist);
    variantDT = buildDT('variant-table', filtered, VARIANT_COLS, variantDT);
}
function resetVariantFilter() {
    document.getElementById('fraser-dist-thresh').value = 200;
    variantDT = buildDT('variant-table', variantRows, VARIANT_COLS, variantDT);
}

// ─── IGV ─────────────────────────────────────────────────────────────────────
async function initIGV(fraser) {
    try {
        const sorted = [...fraser].sort((a, b) => a.pValue - b.pValue);
        const locus = sorted.length
            ? sorted[0].seqnames + ':' + Math.max(1, sorted[0].start - 5000) + '-' + (sorted[0].end + 5000)
            : 'chr1:1-100000';

        const tracks = [{
            name: 'FRASER Results', type: 'annotation', format: 'bed',
            features: sorted.map(r => ({
                chr: String(r.seqnames),
                start: r.start - 1,
                end: r.end,
                name: (r.hgncSymbol || 'NA') + ' (' + r.sampleID + ')',
            })),
            displayMode: 'EXPANDED', color: '#e03131',
        }];

        if (FILES.variant_bed) {
            tracks.push({
                name: 'Rare Variants', type: 'annotation', format: 'bed',
                url: './' + FILES.variant_bed,
                displayMode: 'EXPANDED', color: '#3b5bdb',
            });
        }

        igvBrowser = await igv.createBrowser(document.getElementById('igv-div'), {
            genome: GENOME, locus, tracks,
        });
    } catch (e) {
        document.getElementById('igv-div').textContent = 'IGV failed to load: ' + e;
    }
}

// ─── Apply / Reset ───────────────────────────────────────────────────────────
function applyThresholds() {
    const pval   = parseFloat(document.getElementById('pval-thresh').value) || DEFAULT_PVAL;
    const dpsi   = parseFloat(document.getElementById('dpsi-thresh').value) || DEFAULT_DPSI;
    const zEl    = document.getElementById('zscore-thresh');
    const zscore = zEl ? (parseFloat(zEl.value) || DEFAULT_ZSCORE) : DEFAULT_ZSCORE;
    const families = $('#family-filter').val() || [];

    const fView = families.length ? fraserRows.filter(r => families.includes(r.familyID)) : fraserRows;
    const oView = families.length ? outriderRows.filter(r => families.includes(r.familyID)) : outriderRows;

    renderFraserVolcano(fView, pval, dpsi);
    if (outriderRows.length) renderOutriderVolcano(oView, pval, zscore);

    fraserDT = buildDT('fraser-table', fView, FRASER_COLS, fraserDT);
    if (outriderRows.length) outriderDT = buildDT('outrider-table', oView, OUTRIDER_COLS, outriderDT);

    const common = findCommon(fView, oView, pval, dpsi, zscore);
    if (outriderRows.length) {
        commonDT = buildDT('common-table', common, COMMON_COLS, commonDT);
        document.getElementById('common-section').style.display = common.length ? '' : 'none';
        if (common.length && commonDT) commonDT.columns.adjust().draw();
    }
    renderStats(outriderRows.length ? common.length : null);
}

function resetFilters() {
    document.getElementById('pval-thresh').value = DEFAULT_PVAL;
    document.getElementById('dpsi-thresh').value = DEFAULT_DPSI;
    const zEl = document.getElementById('zscore-thresh');
    if (zEl) zEl.value = DEFAULT_ZSCORE;
    $('#family-filter').val([]).trigger('change');
    applyThresholds();
}

// ─── Bootstrap ───────────────────────────────────────────────────────────────
async function init() {
    try {
        logLine('start', 'Starting data load...', 'log-wait');

        // 1. FRASER (required)
        fraserRows = await fetchCSV('fraser', FILES.fraser);
        if (!fraserRows.length) throw new Error('FRASER file loaded but contained no rows.');

        // 2. OUTRIDER (optional)
        if (FILES.outrider) {
            outriderRows = await fetchCSV('outrider', FILES.outrider);
            // Map ENSG gene IDs to HGNC symbols for common-significant matching
            outriderRows.forEach(r => {
                const mapped = ENSG_TO_HGNC[r.geneID] || null;
                if (mapped) r.hgncSymbol = mapped;
            });
        }

        // Show main content
        logLine('render', 'Rendering charts...', 'log-wait');
        document.getElementById('main-content').style.display = 'block';

        // Render
        const pval = DEFAULT_PVAL, dpsi = DEFAULT_DPSI, zscore = DEFAULT_ZSCORE;

        logLine('render-fv', 'FRASER volcano...', 'log-wait');
        renderFraserVolcano(fraserRows, pval, dpsi);
        logLine('render-fv', 'FRASER volcano', 'log-ok');

        if (outriderRows.length) {
            logLine('render-ov', 'OUTRIDER volcano...', 'log-wait');
            renderOutriderVolcano(outriderRows, pval, zscore);
            logLine('render-ov', 'OUTRIDER volcano', 'log-ok');
        }

        // 3. Variant annotations (optional)
        if (FILES.variant_tsv) {
            variantRows = await fetchCSV('variants', FILES.variant_tsv);
        }

        logLine('render-tbl', 'Tables...', 'log-wait');
        populateFamilyFilter();
        fraserDT = buildDT('fraser-table', fraserRows, FRASER_COLS, null);
        if (outriderRows.length) {
            outriderDT = buildDT('outrider-table', outriderRows, OUTRIDER_COLS, null);
            const common = findCommon(fraserRows, outriderRows, pval, dpsi, zscore);
            commonDT = buildDT('common-table', common, COMMON_COLS, null);
            if (common.length) {
                document.getElementById('common-section').style.display = '';
                if (commonDT) commonDT.columns.adjust().draw();
            }
            renderStats(common.length);
        } else {
            renderStats(null);
        }
        if (variantRows.length) {
            variantDT = buildDT('variant-table', variantRows, VARIANT_COLS, null);
        }
        logLine('render-tbl', 'Tables', 'log-ok');

        // Attach click handlers to plots (once, after initial render)
        document.getElementById('fraser-volcano').on('plotly_click', function(data) {
            const cd = data.points[0].customdata;
            if (cd) {
                showRegionDetails(cd[0], cd[1], cd[2]);
                if (igvBrowser) igvBrowser.search(cd[0] + ':' + Math.max(1, cd[1] - 5000) + '-' + (cd[2] + 5000));
            }
        });

        // Hide loading
        document.getElementById('loading').style.display = 'none';

        // IGV (non-blocking)
        initIGV(fraserRows);

    } catch (err) {
        showError('Load error: ' + err.message + '\n\nFiles expected next to this HTML:\n  ./' + FILES.fraser +
            (FILES.outrider ? '\n  ./' + FILES.outrider : ''));
    }
}

function showError(msg) {
    logLine('fatal', msg.split('\n')[0], 'log-err');
    const box = document.getElementById('error-detail');
    box.style.display = 'block';
    box.textContent = 'ERROR: ' + msg;
}

window.onerror = function(msg, src, line, col) {
    showError('Uncaught JS error: ' + msg + '\n  at ' + src + ':' + line + ':' + col);
};
window.onunhandledrejection = function(e) {
    showError('Unhandled promise rejection: ' + (e.reason || e));
};

window.addEventListener('load', init);
</script>
</body>
</html>
